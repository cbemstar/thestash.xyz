# Neon Postgres: votes and comment count (same DB as Waline). Optional – votes fall back to 0.
# DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require

# Sanity (required for live data; use placeholder-project-id to build without)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: for write access / Studio auth and API automation
SANITY_API_TOKEN=
# Optional: used in metadata and automation response URLs
NEXT_PUBLIC_SITE_URL=https://www.thestash.xyz
# Optional: resume / CV URL (used on /resume page; e.g. PDF or LinkedIn)
# NEXT_PUBLIC_RESUME_URL=https://example.com/resume.pdf
# Optional: if set, POST /api/resources requires header X-Webhook-Secret
WEBHOOK_SECRET=
# IndexNow (optional)
INDEXNOW_KEY=
# Optional override for key file URL (default: https://www.thestash.xyz/<INDEXNOW_KEY>.txt)
# INDEXNOW_KEY_LOCATION=https://www.thestash.xyz/<INDEXNOW_KEY>.txt
# Optional endpoint override (default: https://api.indexnow.org/indexnow)
# INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
# Required to protect POST /api/indexnow
INDEXNOW_WEBHOOK_SECRET=
# Loops.so: newsletter subscription (get key at https://app.loops.so/settings)
LOOPS_API_KEY=
# Optional: Loops mailing list ID to auto-add subscribers (see Lists in Loops dashboard).
# To send the "confirmation" email after signup, create a Loop in Loops with trigger "Contact added" + an Email step (see docs/newsletter.md).
# LOOPS_MAILING_LIST_ID=

# Weekly digest cron: secret for POST /api/cron/weekly-digest (Vercel Cron sends automatically).
# CRON_SECRET=

# Optional: comma-separated subscriber emails for weekly digest (or pass { "emails": [...] } in request body).
# LOOPS_DIGEST_EMAILS=

# Google reCAPTCHA v3 (free plan)
# Create v3 keys in Google reCAPTCHA Admin Console: https://www.google.com/recaptcha/admin
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_site_key
# RECAPTCHA_SECRET_KEY=your_secret_key
# Optional hardening:
# RECAPTCHA_MIN_SCORE=0.7
# RECAPTCHA_ALLOWED_HOSTNAMES=www.thestash.xyz,thestash.xyz

# Google Analytics (optional; defaults to G-YCFR0QKPKM if unset)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-YCFR0QKPKM

# Google AdSense (thestash.xyz – script loads with ca-pub-9235700263244398 if unset)
# Use the exact client ID from AdSense "Get code" / Ad Settings (e.g. ca-pub-9235700263244498)
# so Google detects the script and the Ad Settings preview can load.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-9235700263244398
# ADSENSE_PUBLISHER_ID=ca-pub-9235700263244398
# Ad unit slot IDs from AdSense (replace with your slot IDs after creating ad units)
# NEXT_PUBLIC_ADSENSE_SLOT_HOME=1234567890
# NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=1234567890
