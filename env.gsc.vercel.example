# Google Search Console / Indexing API — env vars for Vercel
# ----------------------------------------------------------
# EASIEST: Run this to generate env.gsc.vercel from your JSON key file:
#   node scripts/write-gsc-env.mjs /path/to/the-stash-487622-ef589e1ee155.json
# Then in Vercel: Settings → Environment Variables → Import .env → choose env.gsc.vercel
#
# OR: Fill in the values below and save as env.gsc.vercel (do not commit).
# ----------------------------------------------------------

# Paste the ENTIRE contents of your service account JSON file (the-stash-487622-ef589e1ee155.json)
# as a SINGLE line. No newlines inside the value.
# In Vercel you paste the raw JSON string; no quotes needed in the UI.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Secret to protect POST /api/search-console/submit. Generate one: openssl rand -hex 32
GSC_WEBHOOK_SECRET=

# Optional. Your Search Console property URL (must match property in GSC). Defaults to site origin.
# GSC_SITE_URL=https://www.thestash.xyz/
